{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "dbc",
      "camelcase": "Dbc",
      "title": "DBC",
      "scope": "source.dbc",
      "file-types": [
        "dbc"
      ],
      "injection-regex": "^dbc$",
      "class-name": "TreeSitterDbc"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Dbc grammar for tree-sitter",
    "authors": [
      {
        "name": "Sophie Eccles",
        "email": "sophie@eccles.dev",
        "url": "https://eccles.dev/"
      }
    ],
    "links": {
      "repository": "https://github.com/sophec/tree-sitter-dbc"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}